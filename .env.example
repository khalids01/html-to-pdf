# Exact internal bearer token shared with the portfolio application.
PDF_SERVICE_SECRET_KEY=replace_with_a_private_shared_service_key

# Docker-network URL of the portfolio app. This renderer only visits this origin.
PORTFOLIO_RESUME_ORIGIN=http://portfolio:4000

# Optional outside Docker; the image installs Playwright Chromium itself.
CHROMIUM_EXECUTABLE_PATH=

PORT=3000
HOSTNAME=0.0.0.0
